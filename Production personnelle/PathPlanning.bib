  author = {Wang, Miaomiao and Li, Zhenglin and Zhao, Qing and Si, Fuyuan and Huang, Dianfang},
  editor = {Lee, G.},
  year = {2018},
  journal = {MATEC Web of Conferences},
  volume = {228},
  pages = {01010},
  issn = {2261-236X},
  doi = {10.1051/matecconf/201822801010},
  urldate = {2025-08-01},
  abstract = {The classical ant colony algorithm has the disadvantages of initial search blindness, slow convergence speed and easy to fall into local optimum when applied to mobile robot path planning. This paper presents an improved ant colony algorithm in order to solve these disadvantages. First, the algorithm use A* search algorithm for initial search to generate uneven initial pheromone distribution to solve the initial search blindness problem. At the same time, the algorithm also limits the pheromone concentration to avoid local optimum. Then, the algorithm optimizes the transfer probability and adopts the pheromone update rule of "incentive and suppression strategy" to accelerate the convergence speed. Finally, the algorithm builds an adaptive model of pheromone coefficient to make the pheromone coefficient adjustment self-adaptive to avoid falling into a local minimum. The results proved that the proposed algorithm is practical and effective.},
  copyright = {http://creativecommons.org/licenses/by/4.0},
  langid = {english},
  file = {/home/pauline/Zotero/storage/LVFP885J/Wang et al. - 2018 - Path Planning Based on an Improved Ant Colony Algorithm.pdf}
}

